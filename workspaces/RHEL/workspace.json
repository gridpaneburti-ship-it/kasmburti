{
  "description": "Red Hat Enterprise Linux is a commercial Linux distribution developed by Red Hat, designed for enterprise use with long-term support.",
  "docker_registry": "https://index.docker.io/v1/",
  "image_src": "rhel.png",
  "categories": [
    "Operating System",
    "Enterprise",
    "Server"
  ],
  "friendly_name": "Red Hat Enterprise Linux",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "compatibility": [
    {
      "version": "1.19.x",
      "image": "redhat/ubi8",
      "uncompressed_size_mb": 2800,
      "available_tags": [
        "8",
        "9",
        "latest"
      ]
    }
  ],
  "run_config": {
    "environment": [
      {
        "name": "DISPLAY",
        "value": "${KASM_DISPLAY}"
      }
    ],
    "privileged": false
  },
  "exec_config": {
    "working_dir": "/home/kasm-user"
  },
  "cores": 2,
  "memory": 4096,
  "notes": "Red Hat Universal Base Image (UBI) provides a free-to-use container base image with enterprise-grade security and long-term support."
}