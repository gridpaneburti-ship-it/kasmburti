{
  "friendly_name": "AlmaLinux 10 KDE",
  "description": "AlmaLinux 10 with KDE Plasma desktop environment for Kasm Workspaces",
  "image_src": "almalinux.svg",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "compatibility": [
    {
      "version": "1.19.x",
      "image": "kasmurti/almalinux-10-kde",
      "uncompressed_size_mb": 11000,
      "available_tags": [
        "10",
        "latest",
        "develop"
      ]
    }
  ],
  "categories": [
    "Operating System",
    "Enterprise"
  ],
  "docker_registry": "https://index.docker.io/v1/",
  "run_config": {
    "environment": [
      {
        "name": "DISPLAY",
        "value": "${KASM_DISPLAY}"
      }
    ],
    "privileged": false
  }
}