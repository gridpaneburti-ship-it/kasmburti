{
  "description": "Manjaro is an accessible, friendly, open-source Linux distribution based on Arch Linux. This workspace includes a KDE Plasma desktop environment.",
  "docker_registry": "https://index.docker.io/v1/",
  "image_src": "manjaro.svg",
  "categories": [
    "Operating System"
  ],
  "friendly_name": "Manjaro Rolling",
  "architecture": [
    "amd64"
  ],
  "compatibility": [
    {
      "version": "1.19.x",
      "image": "manjarolinux/base:latest",
      "uncompressed_size_mb": 3500,
      "available_tags": [
        "latest",
        "rolling",
        "develop"
      ]
    }
  ],
  "run_config": {
    "environment": [
      {
        "name": "DISPLAY",
        "value": "${KASM_DISPLAY}"
      }
    ],
    "privileged": false
  },
  "exec_config": {
    "working_dir": "/home/kasm-user"
  },
  "cores": 2,
  "memory_bytes": 2902458368
}
